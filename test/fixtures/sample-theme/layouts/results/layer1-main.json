{
    "BlockRoot": {
        "BlockType": "table",
        "TableOptions": {
            "ItemsSource": "{Session.Drivers}",
            "Columns": [
                {
                    "Header": "[TITLE]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "DriverRow",
                        "ComponentOptions": {
                            "Vars": { "RowParam": "{Item.Position}" }
                        }
                    }
                },
                {
                    "Template": {
                        "BlockType": "itemstack",
                        "ItemStackOptions": {
                            "ItemSource": "{Item.Stints}",
                            "ItemTemplate": { "BlockType": "component", "Component": "StintCell" }
                        }
                    }
                }
            ]
        }
    }
}
