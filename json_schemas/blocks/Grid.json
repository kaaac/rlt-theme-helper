{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "if": {
    "anyOf": [
      {
        "properties": {
          "BlockType": {
            "const": "grid"
          }
        }
      }
    ]
  },
  "then": {
    "properties": {
      "GridOptions": {
        "type": "object",
        "properties": {
          "Rows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Height": {
                  "description": "Height of the specific row",
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "$ref": "../includes/expression.json"
                    }
                  ]
                },
                "IsStretchHeight": {
                  "description": "Indicates whether all available space should be filled (by height)",
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "$ref": "../includes/expression.json"
                    }
                  ]
                }
              }
            },
            "description": "List of GridRowDefinition"
          },
          "Cols": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Width": {
                  "description": "Width of the specific column",
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "$ref": "../includes/expression.json"
                    }
                  ]
                },
                "IsStretchWidth": {
                  "description": "Indicates whether all available space should be filled (by width)",
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "$ref": "../includes/expression.json"
                    }
                  ]
                }
              }
            },
            "description": "List of GridColDefinition"
          }
        },
        "additionalProperties": false
      },
      "Styles": {
        "$ref": "Styles.json"
      }
    }
  }
}
