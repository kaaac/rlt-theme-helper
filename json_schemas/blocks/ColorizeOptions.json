{
    "type": "object",
    "description": "Colorize options for the block/background",
    "properties": {
        "Enabled": {
            "anyOf": [
                {
                    "type": "boolean"
                },
                {
                    "$ref": "../includes/expression.json"
                }
            ]
        },
        "Color": {
            "$ref": "../includes/color.json"
        },
        "BlendPercentage": {
            "anyOf": [
                {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                },
                {
                    "$ref": "../includes/expression.json"
                }
            ]
        },
        "AlphaCompositionMode": {
            "description": "Composition mode. Can be empty/null. Default: SrcAtop",
            "anyOf": [
                {
                    "type": "string",
                    "enum": [
                        "SrcOver",
                        "Src",
                        "SrcAtop",
                        "SrcIn",
                        "SrcOut",
                        "Dest",
                        "DestAtop",
                        "DestOver",
                        "DestIn",
                        "DestOut",
                        "Clear",
                        "Xor"
                    ]
                },
                {
                    "$ref": "../includes/expression.json"
                }
            ]
        },
        "ColorBlendingMode": {
            "description": "Can be empty/null. Default value: (Screen)",
            "anyOf": [
                {
                    "type": "string",
                    "enum": [
                        "Normal",
                        "Multiply",
                        "Add",
                        "Subtract",
                        "Screen",
                        "Darken",
                        "Lighten",
                        "Overlay",
                        "HardLight"
                    ]
                },
                {
                    "$ref": "../includes/expression.json"
                }
            ]
        },
        "ColorImage": {
            "type": "string",
            "description": "Relative path to a PNG image used as a color overlay or a layer mask (Color is used if not specified)"
        },
        "ColorImageMode": {
            "description": "How the ColorImage is applied: Alpha (draws image over source), Luminance (uses image as a layer mask). Default: Luminance",
            "default": "Luminance",
            "anyOf": [
                {
                    "type": "string",
                    "enum": [
                        "Alpha",
                        "Luminance"
                    ]
                },
                {
                    "$ref": "../includes/expression.json"
                }
            ]
        }
    }
}
