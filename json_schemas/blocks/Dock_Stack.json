{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "if": {
        "anyOf": [
            {
                "properties": {
                    "BlockType": {
                        "const": "stack"
                    }
                }
            },
            {
                "properties": {
                    "BlockType": {
                        "const": "dock"
                    }
                }
            }
        ]
    },
    "then": {
        "properties": {
            "HorizontalDirection": {
                "anyOf": [
                    {
                        "type": "string",
                        "enum": [
                            "LeftToRight",
                            "RightToLeft"
                        ]
                    },
                    {
                        "$ref": "../includes/expression.json"
                    }
                ]
            },
            "VerticalDirection": {
                "anyOf": [
                    {
                        "type": "string",
                        "enum": [
                            "TopToBottom",
                            "BottomToTop"
                        ]
                    },
                    {
                        "$ref": "../includes/expression.json"
                    }
                ]
            },
            "Styles": {
                "$ref": "Styles.json"
            },
            "Components": {
                "type": "array",
                "items": {
                    "type": "object",
                    "$ref": "Component_single.json"
                }
            },
            "PanelOptions": {
                "$ref": "PanelOptions.json"
            }
        }
    }
}
