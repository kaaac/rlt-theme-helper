{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "if": {
        "properties": {
            "BlockType": {
                "const": "image"
            }
        },
        "required": [
            "BlockType"
        ]
    },
    "then": {
        "properties": {
            "ImageOptions": {
                "type": "object",
                "properties": {
                    "Path": {
                        "type": "string",
                        "description": "Path to the image"
                    },
                    "HorizontalAlignment": {
                        "description": "Horizontal alignment of the image",
                        "anyOf": [
                            {
                                "type": "string",
                                "enum": [
                                    "Left",
                                    "Center",
                                    "Right"
                                ]
                            },
                            {
                                "$ref": "../includes/expression.json"
                            }
                        ]
                    },
                    "VerticalAlignment": {
                        "description": "Vertical alignment of the image",
                        "anyOf": [
                            {
                                "type": "string",
                                "enum": [
                                    "Top",
                                    "Center",
                                    "Bottom"
                                ]
                            },
                            {
                                "$ref": "../includes/expression.json"
                            }
                        ]
                    },
                    "Opacity": {
                        "description": "Opacity of the image (0-100)",
                        "anyOf": [
                            {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 100
                            },
                            {
                                "$ref": "../includes/expression.json"
                            }
                        ]
                    },
                    "DefaultPath": {
                        "type": "string",
                        "description": "Used if retrieving an image from Path fails"
                    },
                    "Rotation": {
                        "description": "Rotates the image clockwise, in degrees (values beyond -360/360 are supported)",
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "$ref": "../includes/expression.json"
                            }
                        ]
                    },
                    "RotateAroundCenter": {
                        "description": "If true, rotates the image around its center",
                        "default": false,
                        "anyOf": [
                            {
                                "type": "boolean"
                            },
                            {
                                "$ref": "../includes/expression.json"
                            }
                        ]
                    }
                },
                "description": "Options for the image block"
            }
        }
    }
}
