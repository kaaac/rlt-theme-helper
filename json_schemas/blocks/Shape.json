{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "if": {
        "anyOf": [
            {
                "properties": {
                    "BlockType": {
                        "const": "shape"
                    }
                }
            }
        ],
        "required": [
            "BlockType"
        ]
    },
    "then": {
        "properties": {
            "ShapeOptions": {
                "type": "object",
                "properties": {
                    "ShapeType": {
                        "description": "Type of shape",
                        "anyOf": [
                            {
                                "type": "string",
                                "enum": [
                                    "rectangle",
                                    "ellipse"
                                ]
                            },
                            {
                                "$ref": "../includes/expression.json"
                            }
                        ]
                    },
                    "Fill": {
                        "type": "string",
                        "description": "Color"
                    },
                    "Rotation": {
                        "description": "Rotates the shape clockwise, in degrees",
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "$ref": "../includes/expression.json"
                            }
                        ]
                    },
                    "RotateAroundCenter": {
                        "description": "If true, rotates the shape around its center",
                        "default": false,
                        "anyOf": [
                            {
                                "type": "boolean"
                            },
                            {
                                "$ref": "../includes/expression.json"
                            }
                        ]
                    }
                }
            }
        }
    }
}
