{
  "name": "rlt-theme-helper",
  "displayName": "RLT Theme Helper",
  "description": "Complete development toolkit for Racing League Tools Themes with color picker, variable hints, JSON validation and snippets",
  "version": "0.7.0",
  "publisher": "Kaaac",
  "author": "Kaaac",
  "icon": "rlt_mod_icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaaac/rlt-theme-helper.git"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/theme_description.json",
    "onLanguage:json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "RLT Theme Helper",
      "properties": {
        "rltThemeHelper.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show warnings for unknown style, component and trigger names and variables in theme files."
        }
      }
    },
    "commands": [
      {
        "command": "rlt-theme-helper.showSnippets",
        "title": "RLT: Show Snippets"
      },
      {
        "command": "rlt-theme-helper.addGlobalVariable",
        "title": "RLT: Add Global Variable"
      }
    ],
    "keybindings": [
      {
        "command": "rlt-theme-helper.showSnippets",
        "key": "ctrl+alt+r s",
        "when": "editorTextFocus && editorLangId == json"
      },
      {
        "command": "rlt-theme-helper.addGlobalVariable",
        "key": "ctrl+alt+r v",
        "when": "editorTextFocus && editorLangId == json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "components/**/*.json",
          "components/*.json"
        ],
        "url": "./json_schemas/schema_component.json",
        "icon": "rlt_icon.svg"
      },
      {
        "fileMatch": [
          "layer*.json",
          "layer*/*.json"
        ],
        "url": "./json_schemas/schema_layer.json",
        "icon": "rlt_icon.svg"
      },
      {
        "fileMatch": "theme_description.json",
        "url": "./json_schemas/theme_description.json"
      },
      {
        "fileMatch": "layout_description.json",
        "url": "./json_schemas/layout_description.json",
        "icon": "rlt_icon.svg"
      },
      {
        "fileMatch": [
          "styles/**/*.json",
          "styles.json"
        ],
        "url": "./json_schemas/schema_style_file.json",
        "icon": "rlt_icon.svg"
      },
      {
        "fileMatch": [
          "triggers/**/*.json",
          "Triggers/**/*.json"
        ],
        "url": "./json_schemas/schema_trigger_file.json",
        "icon": "rlt_icon.svg"
      },
      {
        "fileMatch": "vars/**/*.json",
        "url": "./json_schemas/global_vars.json",
        "icon": "rlt_icon.svg"
      },
      {
        "fileMatch": "localizations/*.json",
        "url": "./json_schemas/localization.json",
        "icon": "rlt_icon.svg"
      },
      {
        "fileMatch": "public_properties.json",
        "url": "./json_schemas/public_properties.json"
      },
      {
        "fileMatch": "global_vars.json",
        "url": "./json_schemas/global_vars.json"
      },
      {
        "fileMatch": "text_options.json",
        "url": "./json_schemas/text_options_deprecated.json"
      }
    ],
    "icons": {
      "rlt-iconbar-A": {
        "description": "RLT Theme Icon for status bar",
        "default": {
          "fontPath": "./font/font_rlt_mod.ttf",
          "fontCharacter": "A"
        }
      },
      "rlt-iconbar-B": {
        "description": "RLT Theme Icon for status bar",
        "default": {
          "fontPath": "./font/font_rlt_mod.ttf",
          "fontCharacter": "B"
        }
      },
      "rlt-iconbar-C": {
        "description": "RLT Theme Icon for status bar",
        "default": {
          "fontPath": "./font/font_rlt_mod.ttf",
          "fontCharacter": "C"
        }
      },
      "rlt-iconbar-D": {
        "description": "RLT Theme Icon for status bar",
        "default": {
          "fontPath": "./font/font_rlt_mod.ttf",
          "fontCharacter": "D"
        }
      },
      "rlt-iconbar-E": {
        "description": "RLT Theme Icon for status bar",
        "default": {
          "fontPath": "./font/font_rlt_mod.ttf",
          "fontCharacter": "E"
        }
      },
      "rlt-iconbar-F": {
        "description": "RLT Theme Icon for status bar",
        "default": {
          "fontPath": "./font/font_rlt_mod.ttf",
          "fontCharacter": "F"
        }
      },
      "rlt-iconbar-G": {
        "description": "RLT Theme Icon for status bar",
        "default": {
          "fontPath": "./font/font_rlt_mod.ttf",
          "fontCharacter": "G"
        }
      },
      "rlt-iconbar-H": {
        "description": "RLT Theme Icon for status bar",
        "default": {
          "fontPath": "./font/font_rlt_mod.ttf",
          "fontCharacter": "H"
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --main-fields=module,main --sourcemap",
    "watch": "npm run build -- --watch",
    "vscode:prepublish": "npm run build -- --minify",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "test": "tsc -p . && mocha",
    "generate:models": "node scripts/generate.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "20.x",
    "@types/vscode": "^1.88.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "mocha": "^12.0.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
