{
	"root": true,
	"env": {
		"es2022": true,
		"node": true,
		"mocha": true
	},
	"parser": "@typescript-eslint/parser",
	"parserOptions": {
		"ecmaVersion": 2022,
		"sourceType": "module"
	},
	"plugins": ["@typescript-eslint"],
	"extends": [
		"eslint:recommended",
		"plugin:@typescript-eslint/recommended"
	],
	"ignorePatterns": ["out", "dist", "node_modules", "api_models", "json_schemas"],
	"overrides": [
		{
			"files": ["*.js"],
			"rules": {
				"@typescript-eslint/no-var-requires": "off",
				"@typescript-eslint/no-require-imports": "off"
			}
		}
	]
}
